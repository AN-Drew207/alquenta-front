# Copy this file to .env.local and fill in real values. Never commit
# .env.local — see README-entornos.md for which values go with which
# environment (local / Vercel Preview "develop" / Vercel Production).
#
# .env.vercel-preview and .env.vercel-production (git-ignored, not
# auto-loaded — Next.js only picks up .env.local for `next dev`) mirror
# what's actually set in Vercel for each scope, so you don't have to open
# the dashboard just to check a value. Keep them updated by hand.

# Base URL of the backend API (no trailing slash, without "/api" — that
# gets appended by the API client). Points at the matching Render service:
# local: http://localhost:3001
# Preview (develop): https://gestion-inmueble-api-dev.onrender.com
# Production: the production Render URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Which deployment tier this build is running as. Drives the environment
# banner shown at the top of every page when not "production".
# One of: development | production | test
NEXT_PUBLIC_APP_ENV=development

# Canonical public URL of THIS site (no trailing slash) — used for absolute
# URLs in robots.txt/sitemap.xml. Optional; falls back to localhost, so it
# only really matters for Preview/Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# EmailJS (emailjs.com) — used by the contact form. Create a service +
# template there and fill these in. Not part of the environment split;
# fine to reuse the same values everywhere.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
